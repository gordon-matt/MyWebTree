<div class="mwt-root @Class @(pendingLink is not null ? "mwt-linking" : null)" data-theme="@Theme" style="@RootStyle" @attributes="AdditionalAttributes">
    <div class="mwt-shell">
        <aside class="mwt-panel">
            <div class="mwt-panel-head">
                <Icon Name="people" />
                <strong>Family</strong>
                <span class="mwt-count">@People.Count</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error) || !string.IsNullOrWhiteSpace(formError))
            {
                <div class="mwt-banner" role="alert">@(formError ?? Error)</div>
            }

            <label class="mwt-search">
                <Icon Name="search" />
                <input type="search" placeholder="Search the family" aria-label="Search the family" @bind="query" @bind:event="oninput" />
            </label>

            @if (Matches.Count > 0)
            {
                <div class="mwt-results">
                    @foreach (var person in Matches)
                    {
                        <button type="button" class="mwt-result" @onclick="() => JumpToAsync(person)">
                            <span>@person.DisplayName</span>
                            <small>@person.Lifespan @person.BirthPlace</small>
                        </button>
                    }
                </div>
            }

            <div class="mwt-detail">
                @if (editor is not null)
                {
                    <p class="mwt-kicker">@EditorTitle</p>
                    <div class="mwt-form">
                        <div class="mwt-form-row">
                            <label>First name <input @bind="editor.FirstName" maxlength="@Constants.MaxLengths.PersonName" /></label>
                            <label>Last name <input @bind="editor.LastName" maxlength="@Constants.MaxLengths.PersonName" /></label>
                        </div>
                        @if (GenderLocked)
                        {
                            <p class="mwt-meta">@GenderWord(editor.Gender)</p>
                        }
                        else
                        {
                            <label>
                                Gender
                                <select @bind="editor.Gender">
                                    <option value="@Gender.Unknown">Unknown</option>
                                    <option value="@Gender.Male">Male</option>
                                    <option value="@Gender.Female">Female</option>
                                </select>
                            </label>
                        }
                        @if (editor.Kind is RelativeKind.Father or RelativeKind.Mother && editor.RelatesToId is not null && Person(editor.RelatesToId) is { } editedChild)
                        {
                            @FamilyChooser(editedChild, editor.Kind == RelativeKind.Father ? Gender.Male : Gender.Female, null)
                        }
                        @if (AskOtherParent)
                        {
                            <label>
                                Other parent
                                <select @bind="editor.OtherParentId">
                                    <option value="">Just this parent</option>
                                    @foreach (var spouse in OtherParents)
                                    {
                                        <option value="@spouse.Id">@spouse.DisplayName</option>
                                    }
                                </select>
                            </label>
                        }
                        <div class="mwt-date-row">
                            <label>Born year <input type="number" min="1" max="9999" placeholder="Year" value="@Part(editor.BirthYear)" @onchange="SetBirthYear" /></label>
                            <label>Month <input type="number" min="1" max="12" placeholder="Month" value="@Part(editor.BirthMonth)" @onchange="SetBirthMonth" /></label>
                            <label>Day <input type="number" min="1" max="31" placeholder="Day" value="@Part(editor.BirthDay)" @onchange="SetBirthDay" /></label>
                        </div>
                        <div class="mwt-date-row">
                            <label>Died year <input type="number" min="1" max="9999" placeholder="Year" value="@Part(editor.DeathYear)" @onchange="SetDeathYear" /></label>
                            <label>Month <input type="number" min="1" max="12" placeholder="Month" value="@Part(editor.DeathMonth)" @onchange="SetDeathMonth" /></label>
                            <label>Day <input type="number" min="1" max="31" placeholder="Day" value="@Part(editor.DeathDay)" @onchange="SetDeathDay" /></label>
                        </div>
                        <label>Birth place <input @bind="editor.BirthPlace" maxlength="@Constants.MaxLengths.Place" /></label>
                        <label>Death place <input @bind="editor.DeathPlace" maxlength="@Constants.MaxLengths.Place" /></label>
                        <label>Picture address <input @bind="editor.AvatarUrl" maxlength="@Constants.MaxLengths.AvatarUrl" placeholder="https://" /></label>
                        @if (ChooseAvatar is not null)
                        {
                            <button type="button" class="mwt-button" @onclick="ChooseAvatarAsync">Choose picture</button>
                        }
                        <label>Notes <textarea @bind="editor.Notes" maxlength="@Constants.MaxLengths.Notes"></textarea></label>
                        <div class="mwt-form-actions">
                            <button type="button" class="mwt-button mwt-primary" disabled="@saving" @onclick="SaveEditorAsync">Save</button>
                            <button type="button" class="mwt-button" @onclick="CloseEditor">Cancel</button>
                        </div>
                    </div>
                }
                else if (Selected is { } person)
                {
                    <p class="mwt-kicker">@(Kinship(person.Id) is { Length: > 0 } kin ? kin : "Selected")</p>
                    <h2>@person.DisplayName</h2>
                    @if (person.BirthDate is not null || !string.IsNullOrEmpty(person.BirthPlace))
                    {
                        <p class="mwt-meta">Born @person.BirthDate@(string.IsNullOrEmpty(person.BirthPlace) ? "" : " · " + person.BirthPlace)</p>
                    }
                    @if (person.DeathDate is not null || !string.IsNullOrEmpty(person.DeathPlace))
                    {
                        <p class="mwt-meta">Died @person.DeathDate@(string.IsNullOrEmpty(person.DeathPlace) ? "" : " · " + person.DeathPlace)</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(person.Notes))
                    {
                        <p class="mwt-notes">@person.Notes</p>
                    }

                    <div class="mwt-actions">
                        @if (OnOpenPerson.HasDelegate)
                        {
                            <button type="button" class="mwt-button" @onclick="() => OpenSelectedAsync(person)">@OpenPersonText</button>
                        }
                        @if (Editable)
                        {
                            <button type="button" class="mwt-icon-button" title="Edit" aria-label="Edit" @onclick="EditSelected"><Icon Name="edit" /></button>
                            <button type="button" class="mwt-icon-button" title="Center" aria-label="Center" @onclick="() => FocusAsync(person.Id)"><Icon Name="center" /></button>
                            <button type="button" class="mwt-icon-button mwt-danger" title="Delete" aria-label="Delete" @onclick="AskDelete"><Icon Name="trash" /></button>
                        }
                        else
                        {
                            <button type="button" class="mwt-icon-button" title="Center" aria-label="Center" @onclick="() => FocusAsync(person.Id)"><Icon Name="center" /></button>
                        }
                    </div>
                    @if (Editable && confirmDelete)
                    {
                        <div class="mwt-confirm">
                            <p>Remove @person.DisplayName from the tree? Their relatives stay.</p>
                            <div class="mwt-form-actions">
                                <button type="button" class="mwt-button mwt-danger" disabled="@saving" @onclick="DeleteAsync">Delete</button>
                                <button type="button" class="mwt-button" @onclick="() => confirmDelete = false">Keep</button>
                            </div>
                        </div>
                    }
                    @if (person.ParentSets.Count > 0)
                    {
                        <div class="mwt-sets">
                            <p class="mwt-kicker">@(person.ParentSets.Count > 1 ? "Families" : "Parents")</p>
                            @foreach (var set in person.ParentSets)
                            {
                                bool isActive = set.Id == ParentSetRules.ActiveOf(person, activeSets)?.Id;
                                <div class="mwt-set @(isActive ? "mwt-set-active" : null)">
                                    <div class="mwt-set-head">
                                        @if (Editable)
                                        {
                                            <select class="mwt-set-type" aria-label="Type of family" disabled="@saving" value="@set.Type" @onchange="e => ChangeSetTypeAsync(person.Id, set.Id, e)">
                                                <option value="@ParentageType.Birth">Birth</option>
                                                <option value="@ParentageType.Adopted">Adopted</option>
                                                <option value="@ParentageType.Foster">Foster</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <strong class="mwt-set-type">@TypeWord(set.Type)</strong>
                                        }
                                        @if (set.IsPrimary)
                                        {
                                            <span class="mwt-tag" title="Drawn by default">Primary</span>
                                        }
                                        @if (isActive && person.ParentSets.Count > 1)
                                        {
                                            <span class="mwt-tag mwt-tag-active" title="Drawn in the tree now">Showing</span>
                                        }
                                    </div>
                                    @foreach (string parentId in set.ParentIds)
                                    {
                                        <div class="mwt-rel">
                                            <span>@Person(parentId)?.DisplayName</span>
                                            @if (Editable)
                                            {
                                                <button type="button" class="mwt-button" disabled="@saving" @onclick="() => AskUnlink(parentId, set.Id)">Unlink</button>
                                            }
                                        </div>
                                        @if (unlinkTarget == new UnlinkTarget(parentId, set.Id))
                                        {
                                            <div class="mwt-confirm">
                                                <p>Unlink @person.DisplayName and @Person(parentId)?.DisplayName? Both stay in the tree.</p>
                                                <div class="mwt-form-actions">
                                                    <button type="button" class="mwt-button mwt-danger" disabled="@saving" @onclick="() => UnlinkAsync(person.Id, parentId, set.Id)">Unlink</button>
                                                    <button type="button" class="mwt-button" @onclick="() => unlinkTarget = null">Keep</button>
                                                </div>
                                            </div>
                                        }
                                    }
                                    @if (Editable)
                                    {
                                        <label class="mwt-set-date">
                                            Date
                                            <input placeholder="yyyy-mm-dd" maxlength="10" disabled="@saving" value="@set.Date" @onchange="e => ChangeSetDateAsync(person.Id, set.Id, e)" />
                                        </label>
                                    }
                                    else if (set.Date is { } placed)
                                    {
                                        <p class="mwt-meta">@placed</p>
                                    }
                                    <div class="mwt-set-actions">
                                        @if (!isActive)
                                        {
                                            <button type="button" class="mwt-button" @onclick="() => SwitchSetAsync(person.Id, set.Id)">Show in tree</button>
                                        }
                                        @if (Editable && !set.IsPrimary)
                                        {
                                            <button type="button" class="mwt-button" disabled="@saving" @onclick="() => MakePrimaryAsync(person.Id, set.Id)">Make primary</button>
                                        }
                                        @if (Editable)
                                        {
                                            <button type="button" class="mwt-button mwt-danger" disabled="@saving" @onclick="() => AskRemoveSet(set.Id)">Remove</button>
                                        }
                                    </div>
                                    @if (Editable && removeSetId == set.Id)
                                    {
                                        <div class="mwt-confirm">
                                            <p>Remove this @TypeWord(set.Type).ToLowerInvariant() family from @person.DisplayName? The parents stay in the tree.</p>
                                            <div class="mwt-form-actions">
                                                <button type="button" class="mwt-button mwt-danger" disabled="@saving" @onclick="() => RemoveSetAsync(person.Id, set.Id)">Remove</button>
                                                <button type="button" class="mwt-button" @onclick="() => removeSetId = null">Keep</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (Editable)
                    {
                        <div class="mwt-rel-list">
                            @foreach (var row in Relatives(person))
                            {
                                <div class="mwt-rel">
                                    <span>@row.Label · @Person(row.OtherId)?.DisplayName</span>
                                    <button type="button" class="mwt-button" disabled="@saving" @onclick="() => AskUnlink(row.OtherId, row.SetId)">Unlink</button>
                                </div>
                                @if (unlinkTarget == new UnlinkTarget(row.OtherId, row.SetId))
                                {
                                    <div class="mwt-confirm">
                                        <p>Unlink @person.DisplayName and @Person(row.OtherId)?.DisplayName? Both stay in the tree.</p>
                                        <div class="mwt-form-actions">
                                            <button type="button" class="mwt-button mwt-danger" disabled="@saving" @onclick="() => UnlinkAsync(person.Id, row.OtherId, row.SetId)">Unlink</button>
                                            <button type="button" class="mwt-button" @onclick="() => unlinkTarget = null">Keep</button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="mwt-add">
                            <p class="mwt-kicker">Add</p>
                            <div class="mwt-add-row">
                                <button type="button" class="mwt-button" disabled="@(!CanAdd(RelativeKind.Father))" @onclick="() => OpenAdd(PlaceholderKind.Father, person.Id)">Father</button>
                                <button type="button" class="mwt-button" disabled="@(!CanAdd(RelativeKind.Mother))" @onclick="() => OpenAdd(PlaceholderKind.Mother, person.Id)">Mother</button>
                                <button type="button" class="mwt-button" disabled="@(!CanAdd(RelativeKind.Spouse))" @onclick="() => OpenAdd(PlaceholderKind.Spouse, person.Id)">Spouse</button>
                                <button type="button" class="mwt-button" disabled="@(!CanAdd(RelativeKind.Son))" @onclick="() => OpenAdd(PlaceholderKind.Child, person.Id, Gender.Male)">Son</button>
                                <button type="button" class="mwt-button" disabled="@(!CanAdd(RelativeKind.Daughter))" @onclick="() => OpenAdd(PlaceholderKind.Child, person.Id, Gender.Female)">Daughter</button>
                            </div>
                        </div>
                        <div class="mwt-add">
                            <p class="mwt-kicker">Link</p>
                            <div class="mwt-add-row">
                                <button type="button" class="mwt-button @(pendingLink == LinkKind.Parent ? "mwt-pressed" : null)" title="@LinkButtonTitle(LinkKind.Parent)" aria-pressed="@(pendingLink == LinkKind.Parent)" disabled="@(!CanLink(LinkKind.Parent) && pendingLink != LinkKind.Parent)" @onclick="() => BeginLink(LinkKind.Parent)">Parent</button>
                                <button type="button" class="mwt-button @(pendingLink == LinkKind.Spouse ? "mwt-pressed" : null)" title="@LinkButtonTitle(LinkKind.Spouse)" aria-pressed="@(pendingLink == LinkKind.Spouse)" disabled="@(!CanLink(LinkKind.Spouse) && pendingLink != LinkKind.Spouse)" @onclick="() => BeginLink(LinkKind.Spouse)">Spouse</button>
                                <button type="button" class="mwt-button @(pendingLink == LinkKind.Child ? "mwt-pressed" : null)" title="@LinkButtonTitle(LinkKind.Child)" aria-pressed="@(pendingLink == LinkKind.Child)" disabled="@(!CanLink(LinkKind.Child) && pendingLink != LinkKind.Child)" @onclick="() => BeginLink(LinkKind.Child)">Child</button>
                            </div>
                            @if (pendingLink is not null)
                            {
                                <p class="mwt-meta mwt-link-hint" role="status">@LinkPrompt</p>
                                @if (confirmLink)
                                {
                                    <div class="mwt-confirm">
                                        <p>@LinkConfirmText</p>
                                        @if (PendingParentLink is { } parentLink)
                                        {
                                            <div class="mwt-form">
                                                @FamilyChooser(parentLink.Child, Gender.Unknown, parentLink.Parent.Id)
                                            </div>
                                        }
                                        <div class="mwt-form-actions">
                                            <button type="button" class="mwt-button mwt-primary" disabled="@saving" @onclick="ConfirmLinkAsync">Link</button>
                                            <button type="button" class="mwt-button" @onclick="CancelLinkTarget">Choose another</button>
                                            <button type="button" class="mwt-button" @onclick="CancelLink">Cancel</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="mwt-form-actions">
                                        <button type="button" class="mwt-button" @onclick="CancelLink">Cancel</button>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="mwt-kicker">Tree</p>
                    <h2>No one selected</h2>
                    <p class="mwt-meta">Click a card to read about them and put them at the center of the tree.</p>
                }
            </div>
        </aside>

        <div class="mwt-stage">
            <div class="mwt-toolbar" @onpointerdown:stopPropagation="true">
                <button type="button" class="mwt-icon-button" title="Undo" disabled="@(undo.Count == 0 || saving)" @onclick="UndoAsync"><Icon Name="undo" /></button>
                <button type="button" class="mwt-icon-button" title="Redo" disabled="@(redo.Count == 0 || saving)" @onclick="RedoAsync"><Icon Name="redo" /></button>
                <span class="mwt-divider"></span>
                <span class="mwt-stepper" title="Generations of ancestors">
                    <button type="button" class="mwt-icon-button" aria-label="Fewer ancestors" disabled="@(ancestry <= 0)" @onclick="() => SetDepthAsync(false, -1)"><Icon Name="minus" /></button>
                    <strong>@ancestry</strong>
                    <button type="button" class="mwt-icon-button" aria-label="More ancestors" disabled="@(ancestry >= MaxDepth)" @onclick="() => SetDepthAsync(false, 1)"><Icon Name="plus" /></button>
                </span>
                <span class="mwt-stepper" title="Generations of descendants">
                    <button type="button" class="mwt-icon-button" aria-label="Fewer descendants" disabled="@(progeny <= 0)" @onclick="() => SetDepthAsync(true, -1)"><Icon Name="minus" /></button>
                    <strong>@progeny</strong>
                    <button type="button" class="mwt-icon-button" aria-label="More descendants" disabled="@(progeny >= MaxDepth)" @onclick="() => SetDepthAsync(true, 1)"><Icon Name="plus" /></button>
                </span>
                <span class="mwt-divider"></span>
                <button type="button" class="mwt-icon-button @(siblings ? "mwt-pressed" : null)" title="@(siblings ? "Hide siblings" : "Show siblings")" aria-pressed="@siblings" @onclick="ToggleSiblings"><Icon Name="people" /></button>
                <span class="mwt-segment" title="Which ancestors to show">
                    <button type="button" class="mwt-button @(lineage == LineageScope.Bilateral ? "mwt-pressed" : null)" aria-pressed="@(lineage == LineageScope.Bilateral)" @onclick="() => SetLineage(LineageScope.Bilateral)">Both sides</button>
                    <button type="button" class="mwt-button @(lineage == LineageScope.Patrilineal ? "mwt-pressed" : null)" aria-pressed="@(lineage == LineageScope.Patrilineal)" @onclick="() => SetLineage(LineageScope.Patrilineal)">Father's line</button>
                </span>
                @if (HasNonBirthSets || bloodOnly)
                {
                    <button type="button" class="mwt-button @(bloodOnly ? "mwt-pressed" : null)" title="Hide adopted and foster links, and anyone only reached through them" aria-pressed="@(bloodOnly ? "true" : "false")" @onclick="ToggleBloodOnly">Blood relatives</button>
                }
                <button type="button" class="mwt-button" title="Switch between vertical and horizontal" @onclick="ToggleOrientation">
                    @(orientation == TreeOrientation.Vertical ? "Vertical" : "Horizontal")
                </button>
                <span class="mwt-divider"></span>
                <button type="button" class="mwt-icon-button" title="Zoom out" @onclick="() => ZoomByAsync(1 / 1.15)"><Icon Name="minus" /></button>
                <button type="button" class="mwt-icon-button" title="Zoom in" @onclick="() => ZoomByAsync(1.15)"><Icon Name="plus" /></button>
                <button type="button" class="mwt-icon-button" title="Fit" @onclick="FitAsync"><Icon Name="fit" /></button>
            </div>

            <div class="mwt-viewport @(dragging ? "mwt-dragging" : null)" @ref="viewport"
                 @onpointerdown="PanStart" @onpointermove="PanMove" @onpointerup="PanEnd" @onpointerleave="PanEnd">
                @if (People.Count == 0)
                {
                    <div class="mwt-empty">
                        <div class="mwt-empty-card">
                            <Icon Name="people" />
                            <h2>This tree is empty</h2>
                            <p>Add the first person and the chart will grow around them.</p>
                            @if (Editable)
                            {
                                <button type="button" class="mwt-button mwt-primary" @onclick="AddFirst">Add someone</button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="mwt-world" style="@WorldStyle">
                        <svg class="mwt-links" width="@Px(layout.Width)" height="@Px(layout.Height)">
                            @foreach (var link in layout.Links)
                            {
                                <line x1="@Px(link.X1)" y1="@Px(link.Y1)" x2="@Px(link.X2)" y2="@Px(link.Y2)" class="@LinkClass(link)" />
                            }
                        </svg>
                        @foreach (var card in layout.Cards)
                        {
                            var person = Person(RealId(card));
                            string? badge = BadgeLetter(card);
                            <button type="button" class="@CardClass(card)" style="@Place(card)" title="@CardTitle(card, person)"
                                    @onpointerdown:stopPropagation="true" @onclick="() => SelectCard(card)" @ondblclick="() => FocusCardAsync(card)" @ondblclick:stopPropagation="true">
                                <span class="mwt-avatar">
                                    @if (!string.IsNullOrWhiteSpace(person?.AvatarUrl))
                                    {
                                        <img src="@person.AvatarUrl" alt="" />
                                    }
                                    else if (card.IsPlaceholder)
                                    {
                                        <Icon Name="plus" />
                                    }
                                    else
                                    {
                                        @(person?.Initials ?? "?")
                                    }
                                </span>
                                <span class="mwt-card-copy">
                                    <span class="mwt-card-name">@(card.IsPlaceholder ? PlaceholderLabel(card.Placeholder) : person?.DisplayName)</span>
                                    @if (!card.IsPlaceholder && !string.IsNullOrEmpty(person?.Lifespan))
                                    {
                                        <span class="mwt-card-years">@person.Lifespan</span>
                                    }
                                    @if (!card.IsPlaceholder && Kinship(card.Id) is { Length: > 0 } label)
                                    {
                                        <span class="mwt-card-kin">@label</span>
                                    }
                                </span>
                                @if (badge is not null)
                                {
                                    <span class="mwt-badge @(card.ParentType == ParentageType.Adopted ? "mwt-badge-adopted" : "mwt-badge-foster")" title="@TypeWord(card.ParentType)"><span aria-hidden="true">@badge</span><span class="mwt-sr">@TypeWord(card.ParentType)</span></span>
                                }
                            </button>
                            @if (card.IsStub)
                            {
                                <span class="mwt-stub-actions" style="@Place(card)" @onpointerdown:stopPropagation="true">
                                    <button type="button" class="mwt-chip" title="Show @person?.DisplayName under this family" @onclick="() => SwitchSetAsync(card.PersonId!, card.ParentSetId!)">Switch to this family</button>
                                    @if (card.SeeAlso)
                                    {
                                        <button type="button" class="mwt-chip" title="Go to @person?.DisplayName where they are shown in full" @onclick="() => SeeAlsoAsync(card)">See also</button>
                                    }
                                </span>
                            }
                            else if (card.ParentSetCount > 1 && person is not null)
                            {
                                <button type="button" class="mwt-chip mwt-families" style="@Place(card)" aria-haspopup="true" aria-expanded="@(familiesOpenFor == person.Id ? "true" : "false")"
                                        title="@person.DisplayName has @card.ParentSetCount families" @onpointerdown:stopPropagation="true" @onclick="() => ToggleFamilies(person.Id)">@card.ParentSetCount families</button>
                                @if (familiesOpenFor == person.Id)
                                {
                                    <div class="mwt-popover" role="menu" aria-label="Families of @person.DisplayName" style="@Place(card)" @onpointerdown:stopPropagation="true">
                                        @foreach (var set in person.ParentSets)
                                        {
                                            bool current = set.Id == card.ParentSetId;
                                            <button type="button" role="menuitemradio" aria-checked="@(current ? "true" : "false")" class="mwt-popover-item @(current ? "mwt-popover-current" : null)" @onclick="() => SwitchSetAsync(person.Id, set.Id)">
                                                <span class="mwt-check" aria-hidden="true">@(current ? "✓" : "")</span>
                                                <span>@SetSummary(set)</span>
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        }
                    </div>
                }
            </div>
            @if (People.Count > 0)
            {
                <div class="mwt-zoom">@ZoomPercent%</div>
            }
            @if (pendingLink is not null)
            {
                <div class="mwt-link-bar" role="status">@LinkBar</div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Which family a new parent joins. A child with room in an existing family can add to it or start another;
    /// a child with no family only chooses what kind of parent this is. Both write into <see cref="choice"/>.
    /// </summary>
    private RenderFragment FamilyChooser(PersonData child, Gender role, string? excludeParentId) =>
        @<text>
            @{
                var open = OpenSets(child, role, excludeParentId);
            }
            @if (open.Count > 0 || child.ParentSets.Count > 0)
            {
                <label>
                    Family
                    <select @bind="choice.Value">
                        @foreach (var set in open)
                        {
                            <option value="@set.Id">Add to the family: @SetSummary(set)</option>
                        }
                        <option value="@NewFamily">A new family</option>
                    </select>
                </label>
            }
            @if (choice.Value == NewFamily)
            {
                <label>
                    @(child.ParentSets.Count == 0 ? "Parent type" : "Type of the new family")
                    <select @bind="choice.Type">
                        <option value="@ParentageType.Birth">Birth</option>
                        <option value="@ParentageType.Adopted">Adopted</option>
                        <option value="@ParentageType.Foster">Foster</option>
                    </select>
                </label>
            }
        </text>;
}
