        case "minus":
            <path d="M5 12h14" />
            break;
        case "fit":
            <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6" />
