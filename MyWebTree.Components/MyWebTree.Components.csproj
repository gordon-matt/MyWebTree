<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>MyWebTree.Components</RootNamespace>
		<Description>Blazor family tree. Drop it into a Blazor app and hand it a list of people.</Description>
		<PackageTags>family-tree;genealogy;family-chart;blazor;razor-components;mywebtree</PackageTags>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MyWebTree.Core\MyWebTree.Core.csproj" />
	</ItemGroup>

</Project>
